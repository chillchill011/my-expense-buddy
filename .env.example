# --- Accounts and database (Supabase) ---
# Client-visible
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Sheets access (self-hosting) ---
# Create a Google Cloud service account, enable the Google Sheets API, and
# download its JSON key. Users share their spreadsheet with this address.
GOOGLE_SERVICE_ACCOUNT_EMAIL=expense-dashboard@your-project.iam.gserviceaccount.com
# Paste the whole private_key value, newlines included (or as \n escapes).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional ---
# A public, view-only starter spreadsheet users can copy from the setup screen.
VITE_TEMPLATE_SHEET_ID=
